{
  "hosting": {
    "site": "welwitschiadata-com",
    "public": "out",
    "ignore": ["**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.mp4",
        "headers": [
          { "key": "Content-Type", "value": "video/mp4" },
          { "key": "Cache-Control", "value": "public, max-age=31536000" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": "sendContactEmail"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
